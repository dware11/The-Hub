# Copy this file to .env.local and fill in your real values once you've
# created your Supabase project (see README.md for exact steps).
#
# Until NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY are filled
# in, the app runs in DEMO MODE automatically -- it's fully viewable with
# sample data, no setup required, including a simulated signed-in admin so
# the submit form and /admin/review are walkable too.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public base URL of the deployed site — used to build links in the weekly
# digest email. Set this to your real Vercel URL / custom domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Weekly digest email (Resend) ---
# Get a key at https://resend.com — free tier is generous. FROM must be on
# a domain you've verified with Resend.
RESEND_API_KEY=
DIGEST_FROM_EMAIL="C.O.D.E. Engineering Hub <digest@yourdomain.org>"
DIGEST_TO_EMAIL=code@pvamu.edu

# Shared secret Vercel Cron sends as `Authorization: Bearer <value>` when
# it calls /api/cron/weekly-digest, so the endpoint can't be triggered by
# anyone who finds the URL. Set the same value in your Vercel project's
# Cron settings / env vars. Optional locally.
CRON_SECRET=
